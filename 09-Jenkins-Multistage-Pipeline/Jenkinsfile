
pipeline {
    agent any

    environment {
        APP_DIR = '09-Jenkins-Multistage-Pipeline/python-flask-app'
        VENV = "${WORKSPACE}/.venv"
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                echo 'Installing Python dependencies...'
                sh '''
                    python3 -m venv "$VENV"
                    "$VENV/bin/python" -m pip install --upgrade pip
                    "$VENV/bin/python" -m pip install -r "$WORKSPACE/$APP_DIR/requirements.txt"
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '''
                    "$VENV/bin/python" -m unittest discover \
                        -s "$WORKSPACE/$APP_DIR" -p "test_*.py"
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "$DEPLOY_DIR"
                    cp "$WORKSPACE/$APP_DIR/app.py" "$DEPLOY_DIR/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting Flask application...'
                sh '''
                    cd "$DEPLOY_DIR"
                    nohup "$VENV/bin/python" app.py > app.log 2>&1 &
                    echo $! > app.pid
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing application...'
                sh '''
                    "$VENV/bin/python" -m unittest discover \
                        -s "$WORKSPACE/$APP_DIR" -p "test_*.py"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
